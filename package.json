{
  "name": "crm-lifecycle-ops",
  "version": "0.5.1",
  "description": "The AI copilot for lifecycle & CRM operations on Braze, Klaviyo and Iterable: plan, build, check and change campaigns faster without breaking what's live.",
  "keywords": [
    "braze",
    "klaviyo",
    "iterable",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "email-qa",
    "email-testing",
    "sms",
    "push-notifications",
    "crm",
    "lifecycle-marketing",
    "marketing-operations",
    "marketing-automation"
  ],
  "author": "Harsh Singhal (https://github.com/har5h98)",
  "license": "MIT",
  "homepage": "https://github.com/har5h98/crm-lifecycle-ops#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/har5h98/crm-lifecycle-ops.git"
  },
  "bugs": {
    "url": "https://github.com/har5h98/crm-lifecycle-ops/issues"
  },
  "type": "module",
  "bin": {
    "crm-lifecycle-ops-mcp": "dist/mcp-server.js"
  },
  "files": [
    "dist/",
    ".claude-plugin/plugin.json",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "mcpName": "io.github.har5h98/crm-lifecycle-ops",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/mcp/server.ts --bundle --platform=node --format=esm --target=node20 --legal-comments=eof --outfile=dist/mcp-server.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build && npm run smoke",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\""
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "handlebars": "^4.7.10",
    "htmlparser2": "^12.0.0",
    "liquidjs": "^10.30.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
